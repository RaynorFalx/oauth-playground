													"script": {
														"exec": [
															"pm.test(\"Status code is 409 for duplicate email\", function() {\r",
															"    pm.response.to.have.status(409);\r",
															"});\r",
															"\r",
															"pm.test(\"Error message about duplicate email\", function() {\r",
															"    const jsonData = pm.response.json();\r",
															"    \r",
															"    pm.expect(jsonData).to.have.property('messages');\r",
															"    pm.expect(jsonData.messages).to.be.an('array').that.is.not.empty;\r",
															"    \r",
															"    pm.expect(jsonData.messages[0]).to.include(\"already exists\");\r",
															"    pm.expect(jsonData.messages[0]).to.include(\"Email\");\r",
															"});"
